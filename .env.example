# Every environment variable this repository reads, with empty values.
# Copy to the gitignored .env or ~/.Renviron (R reads it at startup) or export in
# your shell; never commit a filled-in copy. Values stay single-quoted.

# ---- Credentials -----------------------------------------------------------
# credential: NEON API token for data downloads (data.neonscience.org account).
# GitHub Actions: the NEON_TOKEN repository secret, mapped only into the probe and fetch steps.
NEON_TOKEN=''

# ---- App runtime (Connect Cloud content variables) -------------------------
# public, referrer-restricted CARTO basemap key; Connect content variable; Esri tiles when absent.
CARTO_BASEMAP_KEY=''
# 1 allows live NEON calls from the app; CI and Connect run with 0 (committed bundles only).
PDE_LIVE=''

# ---- Fetch (scripts/fetch_plant_all.R, R 4.1.1, neonUtilities >= 4.0.1) ---
# NEON release the fetch is pinned to; must equal PLANT_NEON_RELEASE in R/plant_release.R.
PDE_NEON_RELEASE=''
# empty staging directory for the 46 *_raw.rds files and neon-change-log.json.
PDE_RAW_OUT_DIR=''
# first and last query months, YYYY-MM.
PDE_FETCH_START=''
PDE_FETCH_END=''
# NEON download package; must be basic.
PDE_QUERY_PACKAGE=''

# ---- Bundle / index build (scripts/bundle_plant_data.R and friends) --------
# raw staging read by the bundler.
PDE_RAW_DIR=''
# output root for a staged candidate (defaults to the repo).
PDE_OUTPUT_ROOT=''
# repository root override for build scripts run from elsewhere.
PDE_REPO_ROOT=''
# NEON release stamped into bundle meta by the bundler.
NEON_RELEASE=''
# 1 makes a missing neon-change-log.json in PDE_RAW_DIR a build error (set in non-skip refreshes).
PDE_REQUIRE_CHANGE_LOG=''
# receipt fields stamped into every bundle meta.
PDE_BUILD_DATE=''
PDE_SOURCE_START=''
PDE_SOURCE_CUTOFF=''
PDE_SOURCE_RECEIPT_ID=''
PDE_NEON_UTILITIES_VERSION=''
PDE_SOURCE_DIGEST=''
PDE_BUILDER_COMMIT=''
# completeness-index inputs and output.
PDE_SITE_DIR=''
PDE_EXPECTED_DIR=''
PDE_AUTHORITY_RDS=''
PDE_COMPLETENESS_OUT=''

# ---- Validation (scripts/verify_bundle.R, review and content-key scripts) --
PDE_EXPECT_BUILD_DATE=''
PDE_EXPECT_SOURCE_START=''
PDE_EXPECT_SOURCE_CUTOFF=''
PDE_EXPECT_SOURCE_RECEIPT_ID=''
PDE_EXPECT_QUERY_PACKAGE=''
PDE_EXPECT_NEON_UTILITIES_VERSION=''
PDE_EXPECT_SOURCE_DIGEST=''
PDE_EXPECT_BUILDER_COMMIT=''
PDE_EXPECT_RELEASE=''
# legacy: 1 accepted bundles with no NEON release; the refresh no longer sets it.
PDE_EXPECT_RELEASE_MISSING=''
# comma-separated sites allowed to change rows in a refresh review.
PDE_EXPECTED_CHANGED_SITES=''
# file that scripts/content_key.R writes content_changed/changed/new_change_log_ids to.
PDE_CONTENT_KEY_OUT=''

# ---- Release receipts (scripts/write_release_receipts.mjs) -----------------
PDE_RUNTIME_DATA_ROOT=''
PDE_RUNTIME_RECEIPT_OUT=''
PDE_RUNTIME_INVENTORY_OUT=''
PDE_COVER_RECEIPT_OUT=''
# 1 skips the cover receipt (staged data-only receipts).
PDE_SKIP_COVER_RECEIPT=''

# ---- Post-deploy smoke (scripts/post_deploy_smoke.sh, chromedriver probe) --
SMOKE_MAX_ATTEMPTS=''
SMOKE_SLEEP_BASE=''
SMOKE_CONNECT_TIMEOUT=''
SMOKE_MAX_TIME=''
SMOKE_TOTAL_DEADLINE=''
SMOKE_APP_MARKER=''
SMOKE_APP_TITLE_MARKER=''
SMOKE_APP_LANG_MARKER=''
SMOKE_COVER_MARKER=''
SMOKE_APP_RECEIPT=''
SMOKE_COVER_RECEIPT=''
SMOKE_REQUIRE_RECEIPTS=''
SMOKE_BROWSER=''
SMOKE_BROWSER_TIMEOUT=''
SMOKE_SITE=''
# Chrome binary for the ChromeDriver probe (defaults to the runner's Chrome).
CHROME_BIN=''

# ---- Deterministic numerics (CI and the refresh validator) -----------------
OPENBLAS_CORETYPE=''
OPENBLAS_NUM_THREADS=''
OMP_NUM_THREADS=''
